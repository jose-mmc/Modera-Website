<!-- ─── NOTIFY / WAITLIST ─────────────────────────────── -->
<section id="notify">
  <div class="reveal">
    <p class="notify-overline">Be First</p>
    <h2 class="notify-title">Get<br/>Notified</h2>
    <p class="notify-sub">
      The first edition is limited. Once it closes, it does not return.
      Register your place — be part of something that lasts.
    </p>
    <form class="notify-form" id="notifyForm" onsubmit="handleNotify(event)">
      <input type="text" name="_trap" style="display:none" tabindex="-1" autocomplete="off" />
      <input
        class="notify-input"
        type="email"
        id="notifyEmail"
        placeholder="your@email.com"
        required
        autocomplete="email"
      />
      <button class="notify-btn" type="submit">Notify Me</button>
    </form>
    <p class="notify-note">No spam. First edition access only.</p>
    <p class="notify-success" id="notifySuccess">You're on the list. Stay loyal. 충성.</p>
  </div>
</section>

